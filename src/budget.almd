// budget — the Context Budgeter: how full is the model's window, and how hard should
// ctxgate squeeze right now?
//
//   usage   = the latest assistant turn's input tokens (prompt + cache read + cache create)
//             read from the session transcript Claude Code hands every hook (transcript_path)
//   level   = NORMAL → COMPRESS → AGGRESSIVE → ISOLATE as usage crosses the thresholds
//   apply   = derive a tighter Config from the base one for that level
//
// Every hook call also drops a small record in <home>/sessions/<id>.json so `ctxgate status`
// can answer without knowing the transcript path. All pure except the two readers/writer.
import fs
import json
import value
import env
import self.config
import self.dedup
import self.journal

type Level =
  | Normal
  | Compress
  | Aggressive
  | Isolate

type Usage = { used: Int, window: Int, pct: Int, level: Level }

fn level_name(l: Level) -> String = match l {
  Normal => "NORMAL",
  Compress => "COMPRESS",
  Aggressive => "AGGRESSIVE",
  Isolate => "ISOLATE",
}

fn level_of(cfg: config.Config, pct: Int) -> Level =
  if pct >= cfg.lvl_isolate then Isolate
  else if pct >= cfg.lvl_aggressive then Aggressive
  else if pct >= cfg.lvl_compress then Compress
  else Normal

// Compactions leave a `type:"user"` line with `"isCompactSummary":true`; counting them gives an
// exact "has the model just forgotten everything" signal.
effect fn compaction_count(path: String) -> Int = {
  guard path != "" and fs.exists(path) else 0
  list.count(fs.read_lines(path) ?? [], (l) => string.contains(l, "\"isCompactSummary\":true"))
}

// The transcript is JSONL; the last `assistant` line carrying `usage` is the current turn.
// A compaction shows up naturally: the first turn after it has a much smaller prompt.
effect fn usage_from_transcript(path: String) -> Option[Int] = {
  guard path != "" and fs.exists(path) else none
  let lines = fs.read_lines(path) ?? []
  let hit = list.reverse(lines)
    |> list.find((l) => string.contains(l, "\"type\":\"assistant\"") and string.contains(l, "\"usage\""))
  match hit {
    none => none,
    some(l) => match json.parse(l) {
      err(_) => none,
      ok(j) => match value.field(j, "message")? {
        none => none,
        some(m) => match value.field(m, "usage")? {
          none => none,
          some(u) => some((json.get_int(u, "input_tokens") ?? 0)
            + (json.get_int(u, "cache_read_input_tokens") ?? 0)
            + (json.get_int(u, "cache_creation_input_tokens") ?? 0)),
        },
      },
    },
  }
}

fn usage_of(cfg: config.Config, used: Int) -> Usage = {
  let pct = if cfg.window <= 0 then 0 else used * 100 / cfg.window
  Usage { used: used, window: cfg.window, pct: pct, level: level_of(cfg, pct) }
}

// Tighter knobs per level. The principle (learned the hard way, see the bench notes in the
// README): a replacement is only free if the model does not have to ask again, so levels do
// NOT drag the byte thresholds down much — a 3 KB output is cheaper inline than as a summary
// plus a retry. What they do is shrink what a replacement shows, cap outlines, and inject Grep
// limits. Structured views (runner, git, outline) already lose little; the generic head/tail
// view is where the lines go.
// NORMAL is turn-safe: nothing the model asked for is withheld (only outputs Claude Code
// itself would truncate are summarised, plus repeats via dedup). The bench showed why: a
// summary that makes the model page for the rest costs a whole turn, and a turn re-sends the
// entire window — far more than any summary saves while the window is small. The levels
// tighten as the window fills, which is exactly when a saved byte is worth the most.
fn apply(cfg: config.Config, level: Level) -> config.Config = match level {
  Normal => cfg,
  Compress => config.Config { ...cfg,
    max_bash: int.min(cfg.max_bash, 8000), max_read: int.min(cfg.max_read, 60000), max_grep: int.min(cfg.max_grep, 8000), max_other: int.min(cfg.max_other, 10000),
    head: int.max(15, cfg.head * 2 / 3), tail: int.max(15, cfg.tail * 2 / 3), salient: int.max(20, cfg.salient * 2 / 3),
    outline_max: int.min(cfg.outline_max, 90), max_block: int.min(cfg.max_block, 16), grep_head_limit: 80,
  },
  Aggressive => config.Config { ...cfg,
    max_bash: int.min(cfg.max_bash, 4000), max_read: int.min(cfg.max_read, 24000), max_grep: int.min(cfg.max_grep, 4000), max_other: int.min(cfg.max_other, 5000),
    head: 15, tail: 15, salient: 20, line_clip: int.min(cfg.line_clip, 160),
    outline_max: 60, max_block: 12, grep_head_limit: 50,
  },
  Isolate => config.Config { ...cfg,
    max_bash: int.min(cfg.max_bash, 3000), max_read: int.min(cfg.max_read, 12000), max_grep: int.min(cfg.max_grep, 3000), max_other: int.min(cfg.max_other, 3000),
    head: 10, tail: 10, salient: 12, line_clip: 140,
    outline_max: 40, max_block: 8, grep_head_limit: 30,
  },
}

// One-line banner the model sees on every replaced output while squeezed (none when NORMAL).
fn banner(u: Usage) -> Option[String] = match u.level {
  Normal => none,
  _ => some("[ctxgate] context ${int.to_string(u.pct)}% → ${level_name(u.level)} (summaries are shorter; fetch from the vault only when needed)"),
}

// ── session record ────────────────────────────────────────────────────────
fn sessions_dir(cfg: config.Config) -> String = "${cfg.home}/sessions"

effect fn record_usage(cfg: config.Config, session_id: String, u: Usage, compactions: Int, transcript: String) -> Unit = {
  guard session_id != "" else ()
  fs.mkdir_p(sessions_dir(cfg))!
  // A new compaction means the model no longer remembers what it saw: the dedup memory for
  // this session must go, and the journal gets a divider so `recall` shows the boundary.
  let prev_compactions = match fs.read_text_if_exists("${sessions_dir(cfg)}/${session_id}.json") {
    ok(some(t)) => match json.parse(t) { ok(j) => json.get_int(j, "compactions") ?? 0, err(_) => 0 },
    _ => 0,
  }
  if compactions > prev_compactions then {
    dedup.forget_session(cfg, session_id)!
    journal.mark(cfg, session_id, "compaction #${int.to_string(compactions)}")!
  } else ()
  fs.write("${sessions_dir(cfg)}/${session_id}.json", json.stringify(value.object([
    ("session", value.str(session_id)),
    ("compactions", value.int(compactions)),
    ("transcript", value.str(transcript)),
    ("used", value.int(u.used)),
    ("window", value.int(u.window)),
    ("pct", value.int(u.pct)),
    ("level", value.str(level_name(u.level))),
    ("ts", value.int(env.unix_timestamp())),
  ])))!
}

// Claude Code's status line receives the authoritative `context_window.used_percentage`.
// `ctxgate statusline` stores it per session; when the record is fresh it beats our own
// transcript estimate (which cannot see the system prompt or the pending turn).
let REPORTED_FRESH_SECS = 180

effect fn record_reported(cfg: config.Config, session_id: String, pct: Int) -> Unit = {
  guard session_id != "" else ()
  fs.mkdir_p(sessions_dir(cfg))!
  fs.write("${sessions_dir(cfg)}/${session_id}.reported.json", json.stringify(value.object([
    ("pct", value.int(pct)), ("ts", value.int(env.unix_timestamp())),
  ])))!
}

effect fn reported_pct(cfg: config.Config, session_id: String) -> Option[Int] = {
  guard session_id != "" else none
  match fs.read_text_if_exists("${sessions_dir(cfg)}/${session_id}.reported.json") {
    ok(some(t)) => match json.parse(t) {
      ok(j) => {
        let ts = json.get_int(j, "ts") ?? 0
        if env.unix_timestamp() - ts <= REPORTED_FRESH_SECS then json.get_int(j, "pct") else none
      },
      err(_) => none,
    },
    _ => none,
  }
}

// Resolve the hook's effective config: read usage, record it, tighten. Falls back to the
// base config if the transcript is unreadable — never blocks a hook.
effect fn effective(cfg: config.Config, raw_hook_input: String) -> (config.Config, Option[Usage]) = match json.parse(raw_hook_input) {
  err(_) => (cfg, none),
  ok(j) => {
    let sid = json.get_string(j, "session_id") ?? ""
    let path = json.get_string(j, "transcript_path") ?? ""
    match usage_from_transcript(path) ?? none {
      none => (cfg, none),
      some(used) => {
        let estimate = usage_of(cfg, used)
        let u = match reported_pct(cfg, sid) ?? none {
          some(p) => Usage { used: estimate.used, window: estimate.window, pct: p, level: level_of(cfg, p) },
          none => estimate,
        }
        record_usage(cfg, sid, u, compaction_count(path) ?? 0, path) ?? ()
        (apply(cfg, u.level), some(u))
      },
    }
  },
}

// Most recently updated session record, for `ctxgate status`.
effect fn latest_session(cfg: config.Config) -> Option[Value] = {
  let dir = sessions_dir(cfg)
  guard fs.exists(dir) else none
  let names = (fs.list_dir(dir) ?? []) |> list.filter((n) => string.ends_with(n, ".json") and not string.contains(n, ".reported.") and not string.contains(n, ".seen."))
  let stamped = list.filter_map(names, (n) => {
    let p = "${dir}/${n}"
    match fs.modified_at(p) {
      ok(t) => some((t, p)),
      err(_) => none,
    }
  })
  let newest = list.fold(stamped, none, (best: Option[(Int, String)], cur) => match best {
    none => some(cur),
    some(b) => if cur.0 > b.0 then some(cur) else some(b),
  })
  match newest {
    none => none,
    some((_, p)) => match fs.read_text(p) {
      ok(t) => json.parse(t)?,
      err(_) => none,
    },
  }
}

fn test_cfg() -> config.Config = config.Config {
  home: "/tmp/ctxgate-test", max_bash: 30000, max_read: 1_000_000, max_grep: 30000, max_other: 30000,
  head: 30, tail: 30, salient: 40, line_clip: 200, grep_head_limit: 60,
  outline_bin: "ctxgate-outline", outline_max: 120, max_block: 20,
  window: 200000, lvl_compress: 40, lvl_aggressive: 60, lvl_isolate: 75,
  dedup_min: 600, diff_max_cells: 4_000_000, rtk_bin: "", redact: true, retain_days: 14, debug: false,
}

test "levels follow thresholds" {
  let cfg = test_cfg()
  assert_eq(level_of(cfg, 0), Normal)
  assert_eq(level_of(cfg, 39), Normal)
  assert_eq(level_of(cfg, 40), Compress)
  assert_eq(level_of(cfg, 60), Aggressive)
  assert_eq(level_of(cfg, 75), Isolate)
  assert_eq(level_of(cfg, 99), Isolate)
}

test "usage_of computes pct against the window" {
  let u = usage_of(test_cfg(), 130000)
  assert_eq(u.pct, 65)
  assert_eq(u.level, Aggressive)
}

test "apply tightens monotonically" {
  let cfg = test_cfg()
  let c = apply(cfg, Compress)
  let a = apply(cfg, Aggressive)
  let i = apply(cfg, Isolate)
  assert(c.max_bash < cfg.max_bash and a.max_bash < c.max_bash and i.max_bash < a.max_bash)
  assert(c.head <= cfg.head and a.head <= c.head and i.head <= a.head)
  assert_eq(apply(cfg, Normal).max_bash, cfg.max_bash)
  assert_eq(i.grep_head_limit, 30)
}

test "banner only when squeezed" {
  assert(option.is_none(banner(usage_of(test_cfg(), 1000))))
  assert(option.is_some(banner(usage_of(test_cfg(), 150000))))
}
