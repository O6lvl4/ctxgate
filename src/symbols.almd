// symbols — a file's table of contents, from peek (github.com/O6lvl4/peek).
//
// peek owns parsing: Almide, Rust, Go, TypeScript/JavaScript and Python are built in, and any
// tree-sitter provider that speaks peek's `PEEK_OUTLINE_BIN` contract covers the rest. ctxgate
// points that hook at its own helper (`ctxgate-outline`, tree-sitter, 371 languages) unless
// the user has set it already. This module only keeps what is ctxgate's: the compact rendering
// with test-symbol collapsing, and the lookup used by `ctxgate show --symbol`.
import fs
import env
import peek.outline as pk
import self.config
import self.compress

// Names differ from peek's on purpose: same-named definitions across an import shadow each
// other in Almide's test build (almide/almide issue).
type TocEntry = { kind: String, name: String, start: Int, end: Int }
type Toc = { lang: String, total_lines: Int, symbols: List[TocEntry] }

fn from_peek(o: pk.Outline) -> Toc = Toc {
  lang: o.lang,
  total_lines: o.total_lines,
  symbols: list.map(o.symbols, (s) => TocEntry { kind: s.kind, name: s.name, start: s.start, end: s.end }),
}

// ── entry point (effect) ──────────────────────────────────────────────────
effect fn of_file(cfg: config.Config, path: String) -> Result[Toc, String] = {
  let provider = match env.get("PEEK_OUTLINE_BIN") { some(b) => some(b), none => if cfg.outline_bin == "" then none else some(cfg.outline_bin) }
  let lines = string.lines(fs.read_text(path)!)
  ok(from_peek(pk.of_file_with(path, lines, provider)!))
}

// ── lookup / render (pure) ────────────────────────────────────────────────
// Exact name first, then "ends with ::name" / ".name" so `compile` finds `Compiler::compile`.
fn find_entry(o: Toc, name: String) -> Option[TocEntry] =
  match list.find(o.symbols, (s) => s.name == name) {
    some(s) => some(s),
    none => list.find(o.symbols, (s) => string.ends_with(s.name, "::" + name) or string.ends_with(s.name, "." + name)),
  }

// Test code is rarely what a Read is after: when the outline overflows `max`, collapse
// symbols living under a test module (Rust `mod tests`, `*_test` names) into one line.
fn is_test_sym(s: TocEntry) -> Bool =
  string.starts_with(s.name, "tests::") or string.contains(s.name, "::tests::")
    or string.starts_with(s.name, "test_") or string.contains(s.name, "::test_")
    or string.contains(s.name, ".test_") or s.kind == "test"

fn render_toc(o: Toc, max: Int) -> List[String] = {
  let overflow = list.len(o.symbols) > max
  let main_syms = if overflow then list.filter(o.symbols, (s) => not is_test_sym(s)) else o.symbols
  let collapsed = list.len(o.symbols) - list.len(main_syms)
  let shown = list.take(main_syms, max)
  let kind_w = list.fold(shown, 4, (w, s) => int.max(w, string.len(s.kind)))
  let name_w = list.fold(shown, 4, (w, s) => int.max(w, int.min(48, string.len(s.name))))
  var out: List[String] = []
  for s in shown {
    let span = if s.start == s.end then "L${int.to_string(s.start)}" else "L${int.to_string(s.start)}-${int.to_string(s.end)}"
    list.push(out, "  ${pad_r(s.kind, kind_w)}  ${pad_r(compress.clip(s.name, 48), name_w)}  ${span}")
  }
  let rest = list.len(main_syms) - list.len(shown)
  if rest > 0 then list.push(out, "  … ${int.to_string(rest)} more symbols (ctxgate outline <file>)") else ()
  if collapsed > 0 then list.push(out, "  … ${int.to_string(collapsed)} test symbols collapsed (ctxgate outline <file>)") else ()
  out
}

fn pad_r(s: String, width: Int) -> String =
  if string.len(s) >= width then s else s + string.repeat(" ", width - string.len(s))

test "peek's Almide outline comes through with tight ranges" {
  let src = "import fs\n\ntype Point = { x: Int }\n\n// doc\nfn add(a: Int, b: Int) -> Int = a + b\n\neffect fn main() -> Unit = {\n  println(\"hi\")\n}\n\ntest \"adds\" {\n  assert_eq(add(1, 2), 3)\n}\n"
  let o = from_peek(pk.of_lines("almide", string.lines(src)))
  assert_eq(o.lang, "almide")
  assert_eq(list.map(o.symbols, (s) => s.name), ["Point", "add", "main", "adds"])
  match find_entry(o, "main") {
    some(s) => { assert_eq(s.kind, "effect fn"); assert_eq(s.start, 8); assert_eq(s.end, 10) },
    none => assert(false),
  }
}

test "find matches a method by its short name" {
  let o = Toc { lang: "rust", total_lines: 9, symbols: [TocEntry { kind: "fn", name: "Foo::bar", start: 2, end: 5 }] }
  assert(option.is_some(find_entry(o, "bar")))
  assert(option.is_none(find_entry(o, "baz")))
}

test "render caps and reports the remainder" {
  let syms = list.range(0, 5) |> list.map((i) => TocEntry { kind: "fn", name: "f${int.to_string(i)}", start: i * 10 + 1, end: i * 10 + 9 })
  let lines = render_toc(Toc { lang: "rust", total_lines: 50, symbols: syms }, 3)
  assert_eq(list.len(lines), 4)
  assert(string.contains(list.get(lines, 3) ?? "", "2 more"))
}
