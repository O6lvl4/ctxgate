// ctxgate — an agent context firewall for Claude Code.
//
//   ctxgate hook pre          PreToolUse  handler (stdin JSON → stdout JSON)
//   ctxgate hook post         PostToolUse handler
//   ctxgate show <id> [...]   read a vaulted output back, in slices
//   ctxgate list [n]          recent vault entries
//   ctxgate stats             bytes kept out of the model's context
//   ctxgate init [--global]   register the hooks in Claude Code settings
import io
import fs
import env
import json
import value
import regex
import process
import self.config
import self.compress
import self.vault
import self.hook_pre
import self.hook_post
import self.outline
import self.budget
import self.journal
import self.dedup
import self.tune
import self.breakdown

let USAGE = """
ctxgate — agent context firewall for Claude Code

usage:
  ctxgate hook pre | post | session  hook handlers (read JSON on stdin)
  ctxgate show <id> [--grep RE] [--around RE [N]] [--lines A-B] [--head N] [--tail N] [--symbol NAME]
  ctxgate outline <file>             symbol table (kind, name, line range) of a source file
  ctxgate summarize "<command>"      stdin = that command's output → runner-aware summary (cargo/go/pytest/vitest/jest/tsc)
  ctxgate list [N]                   last N vault entries (default 20)
  ctxgate stats                      totals: raw bytes vaulted vs bytes shown
  ctxgate status                     context budget of the latest session (usage, level, thresholds)
  ctxgate recall [N]                 recap of the session: files read, timeline of replaced outputs (for after a compaction)
  ctxgate report                     replacements vs misses, what is softened, and what actually fills the context
  ctxgate doctor                     check the installation: binaries, hooks, CLAUDE.md note, vault
  ctxgate init [--global]            add hooks to .claude/settings.json (or ~/.claude/settings.json)
  ctxgate gc [--days N] [--dry-run]  drop vault entries older than N days (default CTXGATE_RETAIN_DAYS=14)
  ctxgate path <id>                  print the raw file path

env: CTXGATE_HOME, CTXGATE_MAX_BASH/READ/GREP/OTHER, CTXGATE_HEAD, CTXGATE_TAIL,
     CTXGATE_SALIENT, CTXGATE_LINE_CLIP, CTXGATE_GREP_HEAD_LIMIT, CTXGATE_DEBUG=1
"""

effect fn main() -> Unit = {
  let args = env.args()
  let cfg = config.load()!
  match list.get(args, 0) ?? "help" {
    "hook" => cmd_hook(cfg, list.get(args, 1) ?? ""),
    "show" => cmd_show(cfg, list.drop(args, 1)),
    "outline" => cmd_outline(cfg, list.get(args, 1) ?? ""),
    "summarize" => cmd_summarize(cfg, list.get(args, 1) ?? ""),
    "path" => cmd_path(cfg, list.get(args, 1) ?? ""),
    "list" => cmd_list(cfg, list.get(args, 1) ?? "20"),
    "stats" => cmd_stats(cfg),
    "status" => if list.contains(args, "--line") then cmd_status_line(cfg, "") else cmd_status(cfg),
    "recall" => cmd_recall(cfg, list.get(args, 1) ?? "40"),
    "report" => cmd_report(cfg),
    "doctor" => cmd_doctor(cfg),
    "statusline" => cmd_statusline(cfg),
    "init" => cmd_init(cfg, list.contains(args, "--global")),
    "gc" => cmd_gc(cfg, list.drop(args, 1), true),
    "version" | "--version" | "-V" => println("ctxgate 0.11.0"),
    _ => println(USAGE),
  }
}

// ── hooks ─────────────────────────────────────────────────────────────────
// Hooks must never block the agent: swallow everything, print JSON only on a rewrite.
effect fn cmd_hook(base: config.Config, which: String) -> Unit = {
  let raw = io.read_all()
  vault.debug_dump(base, which, raw) ?? ()
  // Context Budgeter: tighten the config as the window fills; banner tells the model why.
  let (cfg0, usage) = budget.effective(base, raw) ?? (base, none)
  // self-tuning: kinds of replacement that made the model ask again are softened
  let sid0 = match json.parse(raw) { ok(j) => json.get_string(j, "session_id") ?? "", err(_) => "" }
  let cfg = tune.adjust(cfg0, sid0) ?? cfg0
  let banner = match usage {
    some(u) => budget.banner(u) ?? "",
    none => "",
  }
  auto_gc(base) ?? ()
  let out = match which {
    "pre" => hook_pre.run(cfg, raw) ?? none,
    "post" => hook_post.run(cfg, raw, banner) ?? none,
    "session" => session_digest(cfg, raw) ?? none,
    "compact" => { on_compact(cfg, raw) ?? (); none },
    _ => none,
  }
  match out {
    some(s) => println(s),
    none => (),
  }
}

// ── show ──────────────────────────────────────────────────────────────────
type Slice =
  | All
  | Grep(String)
  | Around(String, Int)
  | Lines(Int, Int)
  | Head(Int)
  | Tail(Int)
  | Symbol(String)

fn parse_slice(rest: List[String]) -> Slice = {
  let flag = list.get(rest, 0) ?? ""
  let a = list.get(rest, 1) ?? ""
  let b = list.get(rest, 2) ?? ""
  match flag {
    "--symbol" => Symbol(a),
    "--grep" => Grep(a),
    "--around" => Around(a, int.parse(b) ?? 20),
    "--head" => Head(int.parse(a) ?? 50),
    "--tail" => Tail(int.parse(a) ?? 50),
    "--lines" => match string.split_once(a, "-") {
      some((lo, hi)) => Lines(int.parse(lo) ?? 1, int.parse(hi) ?? 1_000_000),
      none => Lines(int.parse(a) ?? 1, int.parse(a) ?? 1),
    },
    _ => All,
  }
}

fn numbered_line(i: Int, line: String, width: Int) -> String =
  "${compress.pad_left(int.to_string(i), width)}│ ${line}"

// Pure slicing over the raw text; returns rendered lines.
fn slice_text(text: String, s: Slice) -> List[String] = {
  let lines = string.lines(text)
  let n = list.len(lines)
  let width = compress.digits(n)
  let all = list.enumerate(lines) |> list.map((p) => (p.0 + 1, p.1))
  let render = (ps: List[(Int, String)]) => list.map(ps, (p) => numbered_line(p.0, p.1, width))
  match s {
    All => lines,
    Symbol(_) => lines,   // handled in cmd_show (needs the file, not the vault text)
    Head(k) => render(list.take(all, k)),
    Tail(k) => render(list.drop(all, int.max(0, n - k))),
    Lines(lo, hi) => render(list.filter(all, (p) => p.0 >= lo and p.0 <= hi)),
    Grep(re) => render(list.filter(all, (p) => regex.is_match(re, p.1))),
    Around(re, ctx) => {
      let hits = list.filter(all, (p) => regex.is_match(re, p.1)) |> list.map((p) => p.0)
      let keep = list.filter(all, (p) => list.any(hits, (h) => p.0 >= h - ctx and p.0 <= h + ctx))
      // insert a separator where the kept ranges are discontiguous
      var out: List[String] = []
      var prev = 0
      for p in keep {
        if prev != 0 and p.0 != prev + 1 then list.push(out, "   ⋮") else ()
        list.push(out, numbered_line(p.0, p.1, width))
        prev = p.0
      }
      out
    },
  }
}

effect fn cmd_show(cfg: config.Config, rest: List[String]) -> Unit = {
  let id = vault.resolve(cfg, list.get(rest, 0) ?? "")!
  match parse_slice(list.drop(rest, 1)) {
    Symbol(name) => cmd_symbol(cfg, id, name)!,
    s => {
      let text = vault.get(cfg, id)!
      println(list.join(slice_text(text, s), "\n"))
    },
  }
}

// `--symbol` reads from the ORIGINAL file (the vault may hold only one Read page),
// located via the index entry's label, which for Read is the file path.
effect fn cmd_symbol(cfg: config.Config, id: String, name: String) -> Unit = {
  let es = vault.entries(cfg)!
  let path = match list.find(es, (e) => e.id == id and e.tool == "Read") {
    some(e) => e.label,
    none => err("vault entry ${id} is not a Read; --symbol needs a source file")!,
  }
  let o = outline.of_file(cfg, path)!
  let sym = match outline.find(o, name) {
    some(s) => s,
    none => err("no symbol '${name}' in ${path} (try: ctxgate outline ${path})")!,
  }
  let lines = fs.read_lines(path)!
  let width = compress.digits(list.len(lines))
  println("${sym.kind} ${sym.name}  ${path}:${int.to_string(sym.start)}-${int.to_string(sym.end)}")
  for (i, line) in list.enumerate(lines) {
    if i + 1 >= sym.start and i + 1 <= sym.end then println(numbered_line(i + 1, line, width)) else ()
  }
}

effect fn cmd_outline(cfg: config.Config, path: String) -> Unit = {
  guard path != "" else err("usage: ctxgate outline <file>")
  let o = outline.of_file(cfg, path)!
  println("${path}: ${int.to_string(o.total_lines)} lines, ${o.lang}, ${int.to_string(list.len(o.symbols))} symbols")
  for l in outline.render(o, 100000) { println(l) }
}

effect fn cmd_path(cfg: config.Config, prefix: String) -> Unit = {
  let id = vault.resolve(cfg, prefix)!
  println(vault.entry_path(cfg, id))
}

// ── list / stats ──────────────────────────────────────────────────────────
effect fn cmd_list(cfg: config.Config, n_str: String) -> Unit = {
  let n = int.parse(n_str) ?? 20
  let es = vault.entries(cfg)!
  let recent = list.drop(es, int.max(0, list.len(es) - n))
  if list.is_empty(recent) then println("(vault is empty)") else ()
  for e in recent {
    println("${e.id}  ${compress.pad_left(e.tool, 6)}  ${compress.pad_left(compress.human_bytes(e.bytes), 8)} → ${compress.pad_left(compress.human_bytes(e.kept), 7)}  ${compress.clip(e.label, 70)}")
  }
}

effect fn cmd_stats(cfg: config.Config) -> Unit = {
  let es = vault.entries(cfg)!
  let raw = list.sum(list.map(es, (e) => e.bytes))
  let kept = list.sum(list.map(es, (e) => e.kept))
  let saved = raw - kept
  let pct = if raw == 0 then 0 else saved * 100 / raw
  println("ctxgate vault: ${cfg.home}")
  println("  entries        ${int.to_string(list.len(es))}")
  println("  raw bytes      ${compress.human_bytes(raw)}")
  println("  shown to model ${compress.human_bytes(kept)}")
  println("  kept out       ${compress.human_bytes(saved)}  (${int.to_string(pct)}%, ≈${int.to_string(saved / 4)} tokens)")
}

// ── init ──────────────────────────────────────────────────────────────────
fn hook_entry(matcher: String, which: String) -> Value = value.object([
  ("matcher", value.str(matcher)),
  ("hooks", value.array([value.object([
    ("type", value.str("command")),
    ("command", value.str("ctxgate hook ${which}")),
    ("timeout", value.int(15)),
  ])])),
])

// Pure merge: replaces any existing ctxgate entries with the current ones (so re-running
// `init` after an upgrade picks up new matchers) and leaves every other hook untouched.
fn merge_settings(settings: Value) -> Value = {
  let hooks = value.field(settings, "hooks") ?? value.object([])
  let set = (hs: Value, event: String, entry: Value) => {
    let existing = json.get_array(hs, event) ?? []
    var next = list.filter(existing, (e) => not string.contains(json.stringify(e), "ctxgate hook"))
    list.push(next, entry)
    value.merge(hs, value.object([(event, value.array(next))]))
  }
  let h1 = set(hooks, "PreToolUse", hook_entry("Bash|Grep", "pre"))
  let h2 = set(h1, "PostToolUse", hook_entry("Bash|Read|Grep|Glob|WebFetch|mcp__.*", "post"))
  let h3 = set(h2, "SessionStart", hook_entry("compact|resume", "session"))
  let h4 = set(h3, "PreCompact", hook_entry("", "compact"))
  let h5 = set(h4, "PostCompact", hook_entry("", "compact"))
  value.merge(settings, value.object([("hooks", h5)]))
}

effect fn cmd_init(cfg: config.Config, global: Bool) -> Unit = {
  let dir = if global then "${env.get("HOME") ?? "."}/.claude" else "${env.cwd()!}/.claude"
  let path = "${dir}/settings.json"
  fs.mkdir_p(dir)!
  let current = fs.read_text_if_exists(path)! ?? "{}"
  let settings = json.parse(current) |> result.map_err((e) => "parsing ${path}: ${e}")!
  let merged = merge_settings(settings)
  let had_file = fs.exists(path)
  if had_file then fs.copy(path, "${path}.bak")! else ()
  fs.write(path, json.stringify_pretty(merged) + "\n")!
  println("ctxgate hooks written to ${path}" + (if had_file then " (backup: ${path}.bak)" else ""))
  write_claude_md(if global then "${env.get("HOME") ?? "."}/.claude/CLAUDE.md" else "${env.cwd()!}/CLAUDE.md")!
  println("vault: ${cfg.home}")
  println("restart Claude Code (or /hooks) to pick them up; verify with: ctxgate stats")
}

test "parse_slice understands every flag" {
  assert_eq(parse_slice(["--head", "5"]), Head(5))
  assert_eq(parse_slice(["--tail", "7"]), Tail(7))
  assert_eq(parse_slice(["--lines", "3-9"]), Lines(3, 9))
  assert_eq(parse_slice(["--grep", "err"]), Grep("err"))
  assert_eq(parse_slice(["--around", "err", "4"]), Around("err", 4))
  assert_eq(parse_slice([]), All)
}

test "slice_text lines and around" {
  let text = "a\nb\nerror here\nd\ne\nf"
  assert_eq(slice_text(text, Lines(2, 3)), ["2│ b", "3│ error here"])
  assert_eq(slice_text(text, Around("error", 1)), ["2│ b", "3│ error here", "4│ d"])
  assert_eq(slice_text(text, Tail(1)), ["6│ f"])
}

test "merge_settings is idempotent and preserves other hooks" {
  let base = json.parse("{\"model\":\"x\",\"hooks\":{\"PreToolUse\":[{\"matcher\":\"Bash\",\"hooks\":[]}]}}")!
  let once = merge_settings(base)
  let twice = merge_settings(once)
  assert_eq(json.stringify(once), json.stringify(twice))
  assert_eq(json.get_string(once, "model"), some("x"))
  let pre = json.get_array(value.field(once, "hooks")!, "PreToolUse") ?? []
  assert_eq(list.len(pre), 2)
  let post = json.get_array(value.field(once, "hooks")!, "PostToolUse") ?? []
  assert_eq(list.len(post), 1)
}

// `ctxgate summarize "cargo test" < out.txt` — the same parser the hook uses, for humans and CI.
effect fn cmd_summarize(cfg: config.Config, command: String) -> Unit = {
  let text = io.read_all()
  match hook_post.bash_summary(cfg, command, text) {
    some((_, s)) => println(s),
    none => {
      let s = compress.summarize(text, cfg.head, cfg.tail, cfg.salient, cfg.line_clip)
      println(compress.render("Bash", command, "-", s))
    },
  }
}

// ── status (Context Budgeter) ─────────────────────────────────────────────
effect fn cmd_status(cfg: config.Config) -> Unit = {
  println("ctxgate context budget  (window ${int.to_string(cfg.window / 1000)}k; levels: COMPRESS ≥${int.to_string(cfg.lvl_compress)}%  AGGRESSIVE ≥${int.to_string(cfg.lvl_aggressive)}%  ISOLATE ≥${int.to_string(cfg.lvl_isolate)}%)")
  match budget.latest_session(cfg) ?? none {
    none => println("  no session seen yet (records appear after the first hook call)"),
    some(s) => {
      let used = json.get_int(s, "used") ?? 0
      let pct = json.get_int(s, "pct") ?? 0
      let level = json.get_string(s, "level") ?? "NORMAL"
      let sid = json.get_string(s, "session") ?? ""
      println("  session   ${sid}")
      println("  used      ${int.to_string(used / 1000)}k tokens  (${int.to_string(pct)}%)  → ${level}")
      let eff = budget.apply(cfg, budget.level_of(cfg, pct))
      println("  effective budgets  bash ${int.to_string(eff.max_bash)}  read ${int.to_string(eff.max_read)}  grep ${int.to_string(eff.max_grep)}  head/tail ${int.to_string(eff.head)}/${int.to_string(eff.tail)}  outline ${int.to_string(eff.outline_max)}")
      let es = vault.entries(cfg)! |> list.filter((e) => e.session == sid)
      let raw = list.sum(list.map(es, (e) => e.bytes))
      let kept = list.sum(list.map(es, (e) => e.kept))
      println("  this session: ${int.to_string(list.len(es))} outputs vaulted, ${compress.human_bytes(raw - kept)} kept out of context (≈${int.to_string((raw - kept) / 4)} tokens)")
    },
  }
}

// ── statusline ────────────────────────────────────────────────────────────
// `ctxgate statusline` reads Claude Code's status-line JSON on stdin, records the authoritative
// context_window.used_percentage for the session (the Budgeter prefers it over its own estimate
// while fresh), and prints one segment: "ctxgate COMPRESS 42% · saved 195KB".
effect fn cmd_statusline(cfg: config.Config) -> Unit = {
  let raw = io.read_all()
  match json.parse(raw) {
    err(_) => cmd_status_line(cfg, ""),
    ok(j) => {
      let sid = json.get_string(j, "session_id") ?? ""
      let pct = match value.field(j, "context_window")? {
        some(cw) => match json.get_float(cw, "used_percentage") {
          some(f) => some(float.to_int(f)),
          none => json.get_int(cw, "used_percentage"),
        },
        none => none,
      }
      match pct {
        some(p) => budget.record_reported(cfg, sid, p) ?? (),
        none => (),
      }
      cmd_status_line(cfg, sid)
    },
  }
}

// One line for a prompt or status bar. `sid` empty → latest session.
effect fn cmd_status_line(cfg: config.Config, sid_hint: String) -> Unit = {
  let s = match budget.latest_session(cfg) ?? none {
    some(v) => v,
    none => value.object([]),
  }
  let sid = if sid_hint != "" then sid_hint else json.get_string(s, "session") ?? ""
  let pct = match budget.reported_pct(cfg, sid) ?? none {
    some(p) => p,
    none => json.get_int(s, "pct") ?? 0,
  }
  let level = budget.level_name(budget.level_of(cfg, pct))
  let es = vault.entries(cfg)! |> list.filter((e) => e.session == sid)
  let saved = list.sum(list.map(es, (e) => e.bytes - e.kept))
  println("ctxgate ${level} ${int.to_string(pct)}% · saved ${compress.human_bytes(int.max(0, saved))}")
}

// ── SessionStart (compact / resume) ───────────────────────────────────────
// After a compaction the model has forgotten which outputs are in the vault. SessionStart
// hooks may print plain text that is added to the context, so we hand back a digest of this
// session's vault entries: enough to know what exists and how to fetch it, nothing more.
effect fn session_digest(cfg: config.Config, raw: String) -> Option[String] = {
  let j = json.parse(raw) ?? value.object([])
  let sid = json.get_string(j, "session_id") ?? ""
  let source = json.get_string(j, "source") ?? ""
  guard sid != "" and (source == "compact" or source == "resume") else none
  journal.recall(cfg, sid, 30)!
}

// PreCompact / PostCompact: the model is about to forget (or just did). Reset the dedup
// memory so nothing is reported as "unchanged since you saw it", and mark the journal.
effect fn on_compact(cfg: config.Config, raw: String) -> Unit = {
  let j = json.parse(raw) ?? value.object([])
  let sid = json.get_string(j, "session_id") ?? ""
  let ev = json.get_string(j, "hook_event_name") ?? "compact"
  guard sid != "" else ()
  dedup.forget_session(cfg, sid)!
  journal.mark(cfg, sid, ev)!
}

effect fn cmd_recall(cfg: config.Config, n_str: String) -> Unit = {
  let n = int.parse(n_str) ?? 40
  let sid = match budget.latest_session(cfg) ?? none {
    some(s) => json.get_string(s, "session") ?? "",
    none => "",
  }
  match journal.recall(cfg, sid, n)! {
    some(t) => println(t),
    none => println("(nothing recorded for the latest session yet)"),
  }
}

// ── gc (retention) ────────────────────────────────────────────────────────
// The vault is append-only; without a ceiling it grows forever and keeps every output a
// user ever saw. `gc` removes store files and session records older than `days`, then rewrites
// index.jsonl without the dropped ids. Hooks run it opportunistically once a day.
effect fn cmd_gc(cfg: config.Config, args: List[String], verbose: Bool) -> Unit = {
  let days = match list.enumerate(args) |> list.find((p) => p.1 == "--days") {
    some((i, _)) => int.parse(list.get(args, i + 1) ?? "") ?? cfg.retain_days,
    none => cfg.retain_days,
  }
  let dry = list.contains(args, "--dry-run")
  guard days > 0 else { if verbose then println("gc: retention disabled (days = 0)") else () }
  let cutoff = env.unix_timestamp() - days * 86400
  var dropped: List[String] = []
  var freed = 0
  let store = vault.store_dir(cfg)
  for n in (fs.list_dir(store) ?? []) {
    let p = "${store}/${n}"
    let old = (fs.modified_at(p) ?? cutoff + 1) < cutoff
    if old and string.ends_with(n, ".txt") then {
      freed = freed + (fs.file_size(p) ?? 0)
      list.push(dropped, string.slice(n, 0, string.len(n) - 4))
      if dry then () else fs.remove(p) ?? ()
    } else ()
  }
  let sessions = "${cfg.home}/sessions"
  var dropped_sessions = 0
  for n in (fs.list_dir(sessions) ?? []) {
    let p = "${sessions}/${n}"
    if (fs.modified_at(p) ?? cutoff + 1) < cutoff then {
      dropped_sessions = dropped_sessions + 1
      if dry then () else fs.remove(p) ?? ()
    } else ()
  }
  if not dry and not list.is_empty(dropped) then {
    let kept = vault.entries(cfg)! |> list.filter((e) => not list.contains(dropped, e.id))
    let lines = list.map(kept, (e) => json.stringify(vault.entry_to_value(e)))
    fs.write(vault.index_path(cfg), list.join(lines, "\n") + (if list.is_empty(lines) then "" else "\n"))!
  } else ()
  if verbose then println("gc${if dry then " (dry run)" else ""}: ${int.to_string(list.len(dropped))} vault entries (${compress.human_bytes(freed)}) and ${int.to_string(dropped_sessions)} session records older than ${int.to_string(days)} days") else ()
}

// At most once per day, from a hook: cheap when there is nothing to do.
effect fn auto_gc(cfg: config.Config) -> Unit = {
  guard cfg.retain_days > 0 else ()
  let marker = "${cfg.home}/.last_gc"
  let last = fs.modified_at(marker) ?? 0
  guard env.unix_timestamp() - last > 86400 else ()
  fs.mkdir_p(cfg.home)!
  fs.write(marker, int.to_string(env.unix_timestamp()))!
  cmd_gc(cfg, [], false)!
}

// ── CLAUDE.md note ────────────────────────────────────────────────────────
// The model has to know the vault exists before it needs it. `init` adds (or refreshes) one
// short block between markers; everything else in the file is untouched.
let CLAUDE_MD_BEGIN = "<!-- ctxgate:begin -->"
let CLAUDE_MD_END = "<!-- ctxgate:end -->"
let CLAUDE_MD_BLOCK = """
<!-- ctxgate:begin -->
## ctxgate (context firewall)
Large tool outputs are replaced by a summary; the raw text is kept in a local vault and the
summary names its id (`ctx:<id>`). When a summary is not enough, fetch exactly what you need
instead of re-running the tool:
- `ctxgate show <id> --symbol <name>` one function/type from a file whose outline you saw
- `ctxgate show <id> --grep <re>` / `--around <re> <n>` / `--lines A-B` / `--tail N` a slice of any vaulted output
- `ctxgate recall` files you read and the timeline of what you saw (use after a context compaction)
Paged Reads (`offset`/`limit`) are never summarised. Ids may be abbreviated to a unique prefix.
Change files with the Edit/Write tools, not shell patches: editing a file you have read from a
script makes the harness re-send its diff into context on the next turn (ctxgate cannot catch that).
<!-- ctxgate:end -->
"""

effect fn write_claude_md(path: String) -> Unit = {
  let current = match fs.read_text_if_exists(path) { ok(some(t)) => t, _ => "" }
  let block = string.trim(CLAUDE_MD_BLOCK)
  let next = match (string.index_of(current, CLAUDE_MD_BEGIN), string.index_of(current, CLAUDE_MD_END)) {
    (some(a), some(b)) => string.slice(current, 0, a) + block + string.drop(current, b + string.len(CLAUDE_MD_END)),
    _ => (if current == "" then "" else string.trim(current) + "\n\n") + block + "\n",
  }
  if next == current then () else {
    fs.write(path, next)!
    println("ctxgate note written to ${path}")
  }
}

// ── report ────────────────────────────────────────────────────────────────
effect fn cmd_report(cfg: config.Config) -> Unit = {
  let (sid, transcript) = match budget.latest_session(cfg) ?? none {
    some(s) => (json.get_string(s, "session") ?? "", json.get_string(s, "transcript") ?? ""),
    none => ("", ""),
  }
  guard sid != "" else println("(no session yet)")
  let es = vault.entries(cfg)! |> list.filter((e) => e.session == sid)
  let raw = list.sum(list.map(es, (e) => e.bytes))
  let kept = list.sum(list.map(es, (e) => e.kept))
  println("ctxgate report  session ${sid}")
  println("  replaced outputs ${int.to_string(list.len(es))}   raw ${compress.human_bytes(raw)} → shown ${compress.human_bytes(kept)}   kept out ${compress.human_bytes(raw - kept)} (≈${int.to_string((raw - kept) / 4)} tokens)")
  let ss = tune.stats(cfg, sid)!
  if list.is_empty(ss) then println("  no replacements observed yet") else {
    println("  kind            hits  misses  softened   (miss = the model asked again within ${int.to_string(tune.RECOVERY_SECS)}s)")
    for s in ss {
      println("  ${compress.pad_left("", 0)}${outline.pad_right(s.kind, 15)} ${compress.pad_left(int.to_string(s.hits), 4)}  ${compress.pad_left(int.to_string(s.misses), 6)}  ${if s.softened then "yes" else "no"}")
    }
  }
  // Where the context actually goes — so a small saving can be read correctly.
  let slices = breakdown.analyze_file(transcript)!
  if list.is_empty(slices) then () else {
    println("── what fills the context (since the last compaction) ──")
    println(breakdown.render(slices, 10))
  }
}

// ── doctor ────────────────────────────────────────────────────────────────
effect fn cmd_doctor(cfg: config.Config) -> Unit = {
  let say = (label: String, good: Bool, detail: String) => println("  ${if good then "✓" else "✗"} ${label}${if detail == "" then "" else "  — " + detail}")
  println("ctxgate doctor")
  let outline_ok = match process.exec_status_timeout(cfg.outline_bin, ["--help"], 3000) { ok(_) => true, err(_) => false }
  say("outline helper (${cfg.outline_bin})", outline_ok, if outline_ok then "" else "Read outlines fall back to head/tail; build tools/ctxgate-outline")
  let rtk_ok = cfg.rtk_bin != "" and (match process.exec_status_timeout(cfg.rtk_bin, ["--version"], 3000) { ok(st) => st.code == 0, err(_) => false })
  say("rtk (${if cfg.rtk_bin == "" then "disabled" else cfg.rtk_bin})", rtk_ok or cfg.rtk_bin == "", if rtk_ok or cfg.rtk_bin == "" then "" else "optional; brew install rtk for the Bash command layer")
  let cwd = env.cwd() ?? "."
  let home_dir = env.get("HOME") ?? "."
  let proj = match fs.read_text_if_exists("${cwd}/.claude/settings.json") { ok(some(t)) => t, _ => "" }
  let glob = match fs.read_text_if_exists("${home_dir}/.claude/settings.json") { ok(some(t)) => t, _ => "" }
  let hooks_ok = string.contains(proj, "ctxgate hook post") or string.contains(glob, "ctxgate hook post")
  say("hooks registered", hooks_ok, if hooks_ok then (if string.contains(proj, "ctxgate hook post") then "project" else "global") else "run: ctxgate init  (or --global)")
  let events = ["PreToolUse", "PostToolUse", "SessionStart", "PreCompact", "PostCompact"]
  let settings = if string.contains(proj, "ctxgate hook") then proj else glob
  let missing = list.filter(events, (e) => not string.contains(settings, "\"" + e + "\""))
  if hooks_ok then say("all hook events", list.is_empty(missing), if list.is_empty(missing) then "" else "missing " + list.join(missing, ", ") + "; re-run ctxgate init") else ()
  let md = match fs.read_text_if_exists("${cwd}/CLAUDE.md") { ok(some(t)) => t, _ => "" }
  let md_g = match fs.read_text_if_exists("${home_dir}/.claude/CLAUDE.md") { ok(some(t)) => t, _ => "" }
  let note_ok = string.contains(md, "ctxgate:begin") or string.contains(md_g, "ctxgate:begin")
  say("CLAUDE.md note", note_ok, if note_ok then "" else "the model does not know about `ctxgate show`; run ctxgate init")
  let probe = "${cfg.home}/.doctor"
  let vault_ok = match fs.mkdir_p(cfg.home) { ok(_) => (match fs.write(probe, "ok") { ok(_) => true, err(_) => false }), err(_) => false }
  if vault_ok then fs.remove(probe) ?? () else ()
  say("vault writable (${cfg.home})", vault_ok, "")
  let sl = match fs.read_text_if_exists("${home_dir}/.claude/statusline.sh") { ok(some(t)) => t, _ => "" }
  say("status line segment", string.contains(sl, "ctxgate statusline"), if string.contains(sl, "ctxgate statusline") then "" else "optional; see README")
  println("  window ${int.to_string(cfg.window / 1000)}k · levels ${int.to_string(cfg.lvl_compress)}/${int.to_string(cfg.lvl_aggressive)}/${int.to_string(cfg.lvl_isolate)}% · retain ${int.to_string(cfg.retain_days)}d · redact ${if cfg.redact then "on" else "off"}")
}
